COMPOSE_PROJECT_NAME=fakegram-backend-prod
FAKEGRAM_DB_NETWORK=fakegram-db-network
APP_IMAGE_TAG=latest

APP_BIND_ADDRESS=127.0.0.1
APP_HOST_PORT=8080

POSTGRES_HOST=pg-haproxy
POSTGRES_PORT=5000
POSTGRES_DB=fakegram
POSTGRES_USER=fakegram
POSTGRES_PASSWORD=change-me-app-db-password
DATABASE_POOL_MAX=20

DEBEZIUM_DB_USER=debezium
DEBEZIUM_DB_PASSWORD=change-me-debezium-password

REDIS_PASSWORD=change-me-redis-password

KAFKA_CLUSTER_ID=qv6-q1DeRYWquRHh3LhxJA
KAFKA_TOPICS=follow:6
KAFKA_HEAP_OPTS=-Xms512m -Xmx768m

SECRET_PASSWORD_KEY=change-me-long-random-string
SECRET_ACCESS_JWT_KEY=change-me-long-random-string
SECRET_REFRESH_JWT_KEY=change-me-long-random-string
