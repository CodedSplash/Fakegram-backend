{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "plugin.name": "pgoutput",
  "database.hostname": "${env:DEBEZIUM_DB_HOST}",
  "database.port": "${env:DEBEZIUM_DB_PORT}",
  "database.user": "${env:DEBEZIUM_DB_USER}",
  "database.password": "${env:DEBEZIUM_DB_PASSWORD}",
  "database.dbname": "${env:DEBEZIUM_DB_NAME}",
  "topic.prefix": "fakegram",
  "slot.name": "debezium_fakegram",
  "slot.drop.on.stop": "false",
  "publication.name": "dbz_publication",
  "publication.autocreate.mode": "disabled",
  "schema.include.list": "public",
  "table.include.list": "public.outbox_events",
  "snapshot.mode": "initial",
  "heartbeat.interval.ms": "10000",
  "tombstones.on.delete": "false",
  "transforms": "outbox",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.table.field.event.id": "id",
  "transforms.outbox.table.field.event.key": "aggregateid",
  "transforms.outbox.table.field.event.payload": "payload",
  "transforms.outbox.table.fields.additional.placement": "type:header:eventType",
  "transforms.outbox.table.expand.json.payload": "true",
  "transforms.outbox.route.by.field": "aggregatetype",
  "transforms.outbox.route.topic.replacement": "${routedByValue}",
  "transforms.outbox.predicate": "isOutboxTable",
  "predicates": "isOutboxTable",
  "predicates.isOutboxTable.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isOutboxTable.pattern": "fakegram\\.public\\.outbox_events",
  "decimal.handling.mode": "string",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "topic.creation.default.replication.factor": "-1",
  "topic.creation.default.partitions": "3",
  "topic.creation.default.cleanup.policy": "delete",
  "topic.creation.default.retention.ms": "604800000"
}
