{
  "name": "fakegram-backend",
  "version": "0.0.1",
  "description": "An educational project that replicates the functionality of the popular social networking platform, Instagram.",
  "author": "CodedSplash",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "docker:dev": "docker compose --env-file .env.docker.dev -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "docker:dev:infra": "docker compose --env-file .env.docker.dev -f docker-compose.yml -f docker-compose.dev.yml up -d redis kafka kafka-init kafka-connect debezium-init kafka-ui",
    "docker:dev:logs": "docker compose --env-file .env.docker.dev -f docker-compose.yml -f docker-compose.dev.yml logs -f",
    "docker:dev:down": "docker compose --env-file .env.docker.dev -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:prod": "docker compose --env-file .env.docker.prod -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "docker:prod:logs": "docker compose --env-file .env.docker.prod -f docker-compose.yml -f docker-compose.prod.yml logs -f",
    "docker:prod:down": "docker compose --env-file .env.docker.prod -f docker-compose.yml -f docker-compose.prod.yml down"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.12",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/throttler": "^6.5.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "crypto-js": "^4.2.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "pg": "^8.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.12",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.9",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.0",
    "prisma": "^7.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core"
    ]
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "@swc/core@1.15.8": true,
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.11.1": true,
    "prisma@7.2.0": true,
    "@prisma/engines@7.2.0": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
