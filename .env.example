PORT=8080
MODE_ENV=dev
CORS_ORIGINS=http://localhost:3000
# Swagger включён при MODE_ENV=dev; в остальных режимах — только при SWAGGER_ENABLED=true
SWAGGER_ENABLED=false

DATABASE_URL="postgresql://fakegram:fakegram@127.0.0.1:5000/fakegram?schema=public"
DATABASE_POOL_MAX=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=fakegram-backend

PROCESSED_EVENTS_RETENTION_DAYS=8

SECRET_PASSWORD_KEY="SECRET_PASSWORD_KEY"
SECRET_ACCESS_JWT_KEY="SECRET_ACCESS_JWT_KEY"
SECRET_REFRESH_JWT_KEY="SECRET_REFRESH_JWT_KEY"
